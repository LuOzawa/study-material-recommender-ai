# 环境变量示例
# 复制为 .env 或直接在启动前 export。不要提交真实的 .env 文件。

# ---------------------------------------------------------------------------
# 数据库（必填）
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/recommend_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# JWT（必填）——至少 32 字节，否则应用启动即失败
# 生成方式：openssl rand -base64 48   或   python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# CORS 白名单（生产必改）
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Hadoop HDFS（可选，未部署时自动回退本地文件系统）
# ---------------------------------------------------------------------------
HADOOP_URI=hdfs://localhost:9000
HADOOP_USER=hadoop
# 从 Spring 提交 YARN 作业时：客户端配置目录 + 普通 MapReduce jar（不是 Spring Boot 可执行 jar）
HADOOP_CONF_DIR=D:/ubuntu/hadoop-conf
HADOOP_JOB_JAR=D:/Users/woke_openclaw/projects/study-material-recommender-ai/backend/target/study-recommend-1.0.0-hadoop-job.jar
HADOOP_USER_NAME=ubuntu
HADOOP_EXPORT_ENABLED=true
HADOOP_EXPORT_CRON=0 30 2 * * ?
HADOOP_EXPORT_BASE_PATH=/recommend/warehouse
HADOOP_EXPORT_LOCAL_ROOT=./storage/hadoop-export
# 真实集群模式：HDFS 输入/输出与 reducer 数（POST /api/admin/hadoop/benchmark-cluster）
HADOOP_CLUSTER_INPUT=/recommend/warehouse/user_behaviors
HADOOP_CLUSTER_OUTPUT=/recommend/warehouse/hotness
HADOOP_CLUSTER_REDUCERS=4

# ---------------------------------------------------------------------------
# AI 服务（FastAPI + LangGraph + vLLM + pgvector）
# 与 ai-service/.env 中的 AI_INTERNAL_TOKEN 保持一致；不配则 AI 接口返回 503。
# ---------------------------------------------------------------------------
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8090
AI_INTERNAL_TOKEN=change-me-internal-token
AI_SERVICE_CONNECT_TIMEOUT_MS=2000
AI_SERVICE_READ_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# 文件存储
# ---------------------------------------------------------------------------
HDFS_BASE_PATH=/recommend/materials
LOCAL_STORAGE_ROOT=./storage

# ---------------------------------------------------------------------------
# 推荐引擎（Python 脚本路径与返回条数）
# ---------------------------------------------------------------------------
RECOMMENDATION_SCRIPT=../recommendation/run_recommendation.py
# 夜间推荐任务使用的 Python；指向 3.11 venv 可避免 pandas 版本问题
RECOMMENDATION_PYTHON=python
RECOMMENDATION_TOP_N=10

# ---------------------------------------------------------------------------
# 运行时日志（logback 读取 app.log.dir，缺省会落在进程工作目录 ./logs）
# ---------------------------------------------------------------------------
APP_LOG_DIR=./logs
