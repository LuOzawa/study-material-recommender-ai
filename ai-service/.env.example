# ---------------------------------------------------------------------------
# study-ai-service configuration
# Copy to `.env` and adjust. Every value has a default in app/config.py.
# ---------------------------------------------------------------------------

# PostgreSQL + pgvector. The schema is created automatically on startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_ai

# vLLM OpenAI-compatible server (chat + embeddings).
#   vllm serve Qwen/Qwen2.5-7B-Instruct --served-model-name qwen2.5-7b-instruct --port 8000
#   vllm serve BAAI/bge-m3 --task embed --served-model-name bge-m3 --port 8001
# A single vLLM instance can expose both when started with --task auto.
VLLM_BASE_URL=http://localhost:8000/v1
# Optional: embeddings can be served by a second vLLM process.
# VLLM_EMBEDDING_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_CHAT_MODEL=qwen2.5-7b-instruct
VLLM_EMBEDDING_MODEL=bge-m3
VLLM_CHAT_TIMEOUT=90
VLLM_EMBEDDING_TIMEOUT=60

# bge-m3 produces 1024-dim vectors. Changing this requires rebuilding the table.
EMBEDDING_DIM=1024

# Spring Boot backend (source of materials for (re)indexing).
SPRING_BASE_URL=http://localhost:8080
# Must match `ai.service.internal-token` in the Spring application.yml.
AI_INTERNAL_TOKEN=change-me-internal-token
AI_INTERNAL_TOKEN_HEADER=X-Internal-Token

# Retrieval / chunking.
CHUNK_SIZE=420
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
MAX_QUERY_REWRITES=1
EMBEDDING_BATCH_SIZE=16

# Server
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO
